# Copy to .env and fill in.

# Required: OpenRouter API key (server-side only — never exposed to the browser)
OPENROUTER_API_KEY=sk-or-v1-...

# Backend port (frontend dev server proxies /api here)
PORT=3033

# Free Nemotron model used by the agent. Any OpenRouter Nemotron id works.
# Quality-first default (free tier):
DEAL_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Faster alternative:
# DEAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Nemotron is a reasoning model; capping effort keeps it fast and stops it
# spending the whole token budget thinking. low | medium | high
REASONING_EFFORT=low

# Enables OpenRouter's web-search plugin so the agent reads live retailer pages.
# The Nemotron model itself is free; the web plugin is billed by OpenRouter
# (~$0.004-0.007/request). Set to false to run 100% free (results will then be
# empty unless a shopping source is configured).
WEB_SEARCH=true
